# Copy to .env (or .env.local, which overrides .env) and adjust the paths.
# Both variables are optional; each falls back to a path inside the repository.
# Read by osim_render/api/tooling_paths.py.

# Shared OpenSim mesh geometry (.vtp), used when a model references geometry by
# name. Defaults to vendor/opensim-gui/opensim-models/Geometry, which is not
# checked in. Either clone opensim-models there (see README) or point this at an
# existing OpenSim Geometry directory.
# OSIM_RENDER_OPENSIM_GEOMETRY_DIR=C:/OpenSim 4.5/Geometry

# Root for .osim models referenced as models/<name>.osim by the dev tooling.
# Defaults to the (untracked) models/ directory in the repository.
# OSIM_RENDER_MODELS_DIR=C:/path/to/models
