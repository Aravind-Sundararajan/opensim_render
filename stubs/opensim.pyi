    def get(self, index: int | str) -> Joint: ...

class MuscleSet:
    def getSize(self) -> int: ...
    def get(self, index: int | str) -> Muscle: ...

class ForceSet:
    def getSize(self) -> int: ...
    def get(self, index: int | str) -> Force: ...

class TimeSeriesTable:
    def __init__(self, filepath: str = "") -> None: ...
    def getColumnLabels(self) -> list[str]: ...
    def getIndependentColumn(self) -> list[float]: ...
    def getDependentColumn(self, label: str) -> list[float]: ...
    def getNumRows(self) -> int: ...
