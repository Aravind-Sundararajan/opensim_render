class Vec3:
    def __init__(self, x: float = 0.0, y: float = 0.0, z: float = 0.0) -> None: ...
    def get(self, index: int) -> float: ...

class Transform:
    def __init__(
        self, rotation: Rotation | None = None, translation: Vec3 | None = None
    ) -> None: ...
    def R(self) -> Rotation: ...
    def p(self) -> Vec3: ...
    def compose(self, other: Any) -> "Transform": ...
    def xformFrameVecToBase(self, vec: Vec3) -> Vec3: ...
    def xformBaseVecToFrame(self, vec: Vec3) -> Vec3: ...

class Rotation:
    def asMat33(self) -> Any: ...
    def setRotationFromAngleAboutX(self, angle: float) -> None: ...
    def setRotationFromAngleAboutY(self, angle: float) -> None: ...
    def setRotationFromAngleAboutZ(self, angle: float) -> None: ...

class PhysicalFrame:
    @staticmethod
    def safeDownCast(obj: Any) -> PhysicalFrame | None: ...
    def getName(self) -> str: ...
    def getTransformInGround(self, state: State) -> Transform: ...
    def findStationLocationInAnotherFrame(
        self, state: State, location: Vec3, target_frame: PhysicalFrame
    ) -> Vec3: ...

class WrapObject:
