class TransformAxis:
    """One axis of a CustomJoint's spatial transform."""
    def getAxis(self) -> Vec3: ...
    def getCoordinateNames(self) -> Any: ...
    def get_coordinates(self, index: int) -> str: ...

class SpatialTransform:
    """The six axes defining a CustomJoint's motion."""
