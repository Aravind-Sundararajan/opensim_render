"""Type stubs for OpenSim library."""

from typing import Any

class Model:
    def __init__(self, model_file: str) -> None: ...
    def getCoordinateSet(self) -> Any: ...
    def getBodySet(self) -> Any: ...
    def getJointSet(self) -> Any: ...
    def getMuscleSet(self) -> Any: ...
    def getMuscles(self) -> Any: ...
    def getForceSet(self) -> Any: ...
    def getName(self) -> str: ...
    def getGround(self) -> Body: ...
    def getGravity(self) -> tuple[float, float, float]: ...
    def initSystem(self) -> State: ...
    def realizePosition(self, state: State) -> None: ...
    def getMarkerSet(self) -> MarkerSet: ...
    def addMarker(self, marker: Marker) -> None: ...
    def getBodyList(self) -> list[Body]: ...
    @staticmethod
    def setDebugLevel(level: int) -> None: ...

# Module-level function
def setDebugLevel(level: int) -> None: ...
def GetVersion() -> str: ...

class State:
    def __init__(self, other: State = ...) -> None: ...
    def getU(self) -> Vector: ...
    def getQErr(self) -> Vector: ...
    def getTime(self) -> float: ...

class Coordinate:
    def getName(self) -> str: ...
    def getRangeMin(self) -> float: ...
    def getRangeMax(self) -> float: ...
    def getDefaultValue(self) -> float: ...
    def setValue(self, state: State, value: float) -> None: ...
    def getValue(self, state: State) -> float: ...

class Body:
    def getName(self) -> str: ...
    def getMass(self) -> float: ...
    def getWrapObjectSet(self) -> WrapObjectSet: ...

class Joint:
    def getName(self) -> str: ...
    def numCoordinates(self) -> int: ...

class GeometryPath:
    """Muscle geometry path."""
    def getPathPointSet(self) -> PathPointSet: ...
    def getCurrentPath(self, state: State) -> ArrayPathPoint: ...
    def getWrapSet(self) -> Any: ...  # PathWrapSet
    def getDefaultColor(self) -> Vec3: ...

class PathWrap:
    """Wrap obstacle along a path segment."""
    def getWrapObject(self) -> WrapObject: ...
    def get_range(self, index: int) -> int: ...  # 0 for start, 1 for end

class Muscle:
    def getName(self) -> str: ...
    def getGeometryPath(self) -> GeometryPath: ...

class Force:
    def getName(self) -> str: ...
    def getConcreteClassName(self) -> str: ...
    def appliesForce(self, state: State) -> bool: ...
    def getRecordValues(self, state: Any) -> Any: ...

class HuntCrossleyForce(Force):
    """Contact force model using Hunt-Crossley method."""
    def get_stiffness(self) -> float: ...
    def get_dissipation_factor(self) -> float: ...
    def get_static_friction(self) -> float: ...
    def get_kinetic_friction(self) -> float: ...
    def get_viscous_friction(self) -> float: ...
    @staticmethod
    def safeDownCast(force: Force) -> HuntCrossleyForce | None: ...

class SmoothSphereHalfSpaceForce(Force):
    """Contact force between sphere and half-space.

    The contact sphere and half-space are reached through the "sphere" and
    "half_space" sockets (see ``getSocket``), not through property accessors.
    """
    def get_stiffness(self) -> float: ...
    def get_dissipation(self) -> float: ...
    def get_static_friction(self) -> float: ...
    def get_kinetic_friction(self) -> float: ...
    def get_viscous_friction(self) -> float: ...
    @staticmethod
    def safeDownCast(force: Force) -> SmoothSphereHalfSpaceForce | None: ...

class ElasticFoundationForce(Force):
    """Contact force using elastic foundation model."""
    def get_stiffness(self) -> float: ...
    def get_dissipation(self) -> float: ...
    def get_static_friction(self) -> float: ...
    def get_kinetic_friction(self) -> float: ...
    @staticmethod
    def safeDownCast(force: Force) -> ElasticFoundationForce | None: ...

class SmoothSphereContactForce(Force):
    """General smooth sphere contact force."""
    def get_stiffness(self) -> float: ...
    @staticmethod
    def safeDownCast(force: Force) -> SmoothSphereContactForce | None: ...

class CoordinateSet:
