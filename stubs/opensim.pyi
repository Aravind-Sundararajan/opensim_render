    def getFrame(self) -> PhysicalFrame: ...
    def getTransform(self) -> Transform: ...
    def get_translation(self) -> Vec3: ...
    def get_xyz_body_rotation(self) -> Vec3: ...

class WrapCylinder(WrapObject):
