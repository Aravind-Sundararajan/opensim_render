class ContactGeometry:
    """Base class for contact geometry."""
    def getName(self) -> str: ...
    def getConcreteClassName(self) -> str: ...
    def getFrame(self) -> PhysicalFrame: ...
    def getLocation(self) -> Vec3: ...
    @staticmethod
    def safeDownCast(obj: Any) -> ContactGeometry | None: ...
    def generateDecorations(
        self,
        fixed: bool,
        hints: ModelDisplayHints,
        state: State,
        appendToThis: ArrayDecorativeGeometry,
    ) -> None: ...

class ContactHalfSpace(ContactGeometry):
    """Half-space contact geometry."""

    pass

class ContactSphere(ContactGeometry):
    """Sphere contact geometry."""
    def getRadius(self) -> float: ...
    def setRadius(self, radius: float) -> None: ...
    @staticmethod
    def safeDownCast(geom: ContactGeometry) -> ContactSphere | None: ...

class ContactMesh(ContactGeometry):
    """Mesh contact geometry."""

    pass

class ContactGeometrySet:
