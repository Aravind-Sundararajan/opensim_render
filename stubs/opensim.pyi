    def safeDownCast(joint: Any) -> "CustomJoint | None": ...

class Function:
    """Base class for OpenSim functions."""

class Constant(Function):
    """Function returning a constant value."""
    def __init__(self, value: float) -> None: ...

class RowVectorVec3:
    """Row vector of 3D vectors."""
    def __init__(self, size: int, value: Vec3) -> None: ...

class TimeSeriesTableVec3:
    """Time series table of 3D vectors."""
    def __init__(self) -> None: ...
    def appendRow(self, time: float, row: RowVectorVec3) -> None: ...
    def setColumnLabels(self, labels: list[str]) -> None: ...

class MarkerWeight:
    """Weight applied to a marker during IK."""
    def __init__(self, name: str, weight: float) -> None: ...

class SetMarkerWeights:
    """Set of marker weights."""
    def __init__(self) -> None: ...
    def cloneAndAppend(self, weight: MarkerWeight) -> None: ...

class MarkersReference:
    """Reference marker trajectories for inverse kinematics."""
    def __init__(
        self, table: TimeSeriesTableVec3, weights: SetMarkerWeights
    ) -> None: ...
    def setDefaultWeight(self, weight: float) -> None: ...

class CoordinateReference:
    """Reference value for a coordinate during inverse kinematics."""
    def __init__(self, name: str, function: Function) -> None: ...
    def setWeight(self, weight: float) -> None: ...

class SimTKArrayCoordinateReference:
    """SimTK array of coordinate references."""
    def __init__(self) -> None: ...
    def push_back(self, reference: CoordinateReference) -> None: ...

class InverseKinematicsSolver:
    """OpenSim's inverse kinematics assembly solver."""
    def __init__(
        self,
        model: Model,
        markers_reference: MarkersReference,
        coordinate_references: SimTKArrayCoordinateReference,
    ) -> None: ...
    def setAccuracy(self, accuracy: float) -> None: ...
    def assemble(self, state: State) -> None: ...
    def track(self, state: State) -> None: ...
    def computeCurrentMarkerError(self, marker_name: str) -> float: ...

class PathPointSet:
