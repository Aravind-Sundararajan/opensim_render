import types
from .core import RETURN_BYTES as RETURN_BYTES
from _typeshed import Incomplete
from collections.abc import Generator
from imageio.core.v3_plugin_api import PluginV3

__all__ = ['imread', 'mimread', 'volread', 'mvolread', 'imwrite', 'mimwrite', 'volwrite', 'mvolwrite', 'help', 'get_reader', 'get_writer', 'RETURN_BYTES']

def help(name=None) -> None: ...

class LegacyReader:
    instance: Incomplete
    last_index: int
    closed: bool
    read_args: Incomplete
    def __init__(self, plugin_instance: PluginV3, **kwargs) -> None: ...
    def close(self) -> None: ...
    def __enter__(self): ...
    def __exit__(self, type: type[BaseException] | None, value: BaseException | None, traceback: types.TracebackType | None) -> None: ...
    def __del__(self) -> None: ...
    @property
    def request(self): ...
    @property
    def format(self) -> None: ...
    def get_length(self): ...
    def get_data(self, index): ...
    def get_next_data(self): ...
    def set_image_index(self, index) -> None: ...
    def get_meta_data(self, index=None): ...
    def iter_data(self) -> Generator[Incomplete]: ...
    def __iter__(self): ...
    def __len__(self) -> int: ...

class LegacyWriter:
    instance: Incomplete
    last_index: int
    closed: bool
    write_args: Incomplete
    def __init__(self, plugin_instance: PluginV3, **kwargs) -> None: ...
    def close(self) -> None: ...
    def __enter__(self): ...
    def __exit__(self, type: type[BaseException] | None, value: BaseException | None, traceback: types.TracebackType | None) -> None: ...
    def __del__(self) -> None: ...
    @property
    def request(self): ...
    @property
    def format(self) -> None: ...
    def append_data(self, im, meta=None): ...
    def set_meta_data(self, meta) -> None: ...

def get_reader(uri, format=None, mode: str = '?', **kwargs): ...
def get_writer(uri, format=None, mode: str = '?', **kwargs): ...
def imread(uri, format=None, **kwargs): ...
def imwrite(uri, im, format=None, **kwargs): ...
def mimread(uri, format=None, memtest=..., **kwargs): ...
def mimwrite(uri, ims, format=None, **kwargs): ...
def volread(uri, format=None, **kwargs): ...
def volwrite(uri, im, format=None, **kwargs): ...
def mvolread(uri, format=None, memtest=..., **kwargs): ...
def mvolwrite(uri, ims, format=None, **kwargs): ...
read = get_reader
save = get_writer
imsave = imwrite
mimsave = mimwrite
volsave = volwrite
mvolsave = mvolwrite
