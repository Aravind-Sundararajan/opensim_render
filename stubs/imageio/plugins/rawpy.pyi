from ..typing import ArrayLike as ArrayLike
from typing import Any, Iterator

class RawPyPlugin(PluginV3):
    def __init__(self, request: Request) -> None: ...
    def close(self) -> None: ...
    def read(self, *, index: int = 0, **kwargs) -> np.ndarray: ...
