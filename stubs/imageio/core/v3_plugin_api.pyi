import numpy as np
import types
from . import Request as Request
from ..typing import ArrayLike as ArrayLike
from dataclasses import dataclass
from typing import Any, Iterator

@dataclass
class ImageProperties:
    shape: tuple[int, ...]
    dtype: np.dtype
    n_images: int | None = ...
    is_batch: bool = ...
    spacing: tuple | None = ...

class PluginV3:
    def __init__(self, request: Request) -> None: ...
    def read(self, *, index: int = 0) -> np.ndarray: ...
    def write(self, ndimage: ArrayLike | list[ArrayLike]) -> bytes | None: ...
    def iter(self) -> Iterator[np.ndarray]: ...
    def properties(self, index: int = 0) -> ImageProperties: ...
    def metadata(self, index: int = 0, exclude_applied: bool = True) -> dict[str, Any]: ...
    def close(self) -> None: ...
    @property
    def request(self) -> Request: ...
    def __enter__(self) -> PluginV3: ...
    def __exit__(self, type: type[BaseException] | None, value: BaseException | None, traceback: types.TracebackType | None) -> None: ...
    def __del__(self) -> None: ...
