import enum
from ..core import get_remote_file as get_remote_file, urlopen as urlopen
from _typeshed import Incomplete
from collections.abc import Generator

URI_BYTES: int
URI_FILE: int
URI_FILENAME: int
URI_ZIPPED: int
URI_HTTP: int
URI_FTP: int

class IOMode(str, enum.Enum):
    read = 'r'
    write = 'w'

class ImageMode(str, enum.Enum):
    single_image = 'i'
    multi_image = 'I'
    single_volume = 'v'
    multi_volume = 'V'
    any_mode = '?'

class Mode(str, enum.Enum):
    read_single_image = 'ri'
    read_multi_image = 'rI'
    read_single_volume = 'rv'
    read_multi_volume = 'rV'
    read_any = 'r?'
    write_single_image = 'wi'
    write_multi_image = 'wI'
    write_single_volume = 'wv'
    write_multi_volume = 'wV'
    write_any = 'w?'
    @property
    def io_mode(self) -> IOMode: ...
    @property
    def image_mode(self) -> ImageMode: ...
    def __getitem__(self, key): ...

SPECIAL_READ_URIS: Incomplete
RETURN_BYTES: str
EXAMPLE_IMAGES: Incomplete

class Request:
    raw_uri: Incomplete
    def __init__(self, uri, mode, *, extension=None, format_hint: str = None, **kwargs) -> None: ...
    @property
    def filename(self): ...
    @property
    def extension(self) -> str: ...
    @property
    def format_hint(self) -> str | None: ...
    @format_hint.setter
    def format_hint(self, format: str) -> None: ...
    @property
    def mode(self): ...
    @property
    def kwargs(self): ...
    def get_file(self): ...
    def get_local_filename(self): ...
    def finish(self) -> None: ...
    def get_result(self): ...
    @property
    def firstbytes(self): ...

def read_n_bytes(f, N): ...

class SeekableFileObject:
    f: Incomplete
    closed: bool
    def __init__(self, f) -> None: ...
    def read(self, n=None): ...
    def readline(self) -> Generator[Incomplete, Incomplete]: ...
    def tell(self): ...
    def seek(self, i, mode: int = 0): ...
    def close(self) -> None: ...
    def isatty(self): ...
    def seekable(self): ...

class InitializationError(Exception): ...
