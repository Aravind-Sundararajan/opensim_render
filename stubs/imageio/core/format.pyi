MODENAMES = ImageMode

class Format:
    def __init__(self, name, description, extensions=None, modes=None) -> None: ...
    @property
    def doc(self): ...
    @property
    def name(self): ...
    @property
    def description(self): ...
    @property
    def extensions(self): ...
    @property
    def modes(self): ...
    def get_reader(self, request): ...
    def get_writer(self, request): ...
    def can_read(self, request): ...
    def can_write(self, request): ...
    class _BaseReaderWriter:
        def __init__(self, format, request) -> None: ...
        @property
        def format(self): ...
        @property
        def request(self): ...
        def __enter__(self): ...
        def __exit__(self, type: type[BaseException] | None, value: BaseException | None, traceback: types.TracebackType | None) -> None: ...
        def __del__(self) -> None: ...
        def close(self) -> None: ...
        @property
        def closed(self): ...
    class Reader(_BaseReaderWriter):
        def get_length(self): ...
        def get_data(self, index, **kwargs): ...
        def get_next_data(self, **kwargs): ...
        def set_image_index(self, index, **kwargs) -> None: ...
        def get_meta_data(self, index=None): ...
        def iter_data(self) -> Generator[Incomplete]: ...
        def __iter__(self): ...
        def __len__(self) -> int: ...
    class Writer(_BaseReaderWriter):
        def append_data(self, im, meta=None): ...
        def set_meta_data(self, meta): ...

class FormatManager:
    def __iter__(self): ...
    def __len__(self) -> int: ...
    def __getitem__(self, name): ...
    def sort(self, *names) -> None: ...
    def add_format(self, iio_format, overwrite: bool = False) -> None: ...
    def search_read_format(self, request): ...
    def search_write_format(self, request): ...
    def get_format_names(self): ...
    def show(self) -> None: ...
